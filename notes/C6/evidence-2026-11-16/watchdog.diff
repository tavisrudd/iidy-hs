+-- C6 DIAGNOSTIC (not for commit): after 25 s, dump every Haskell thread.
+c6Watchdog :: IO ()
+c6Watchdog = do
+    threadDelay 25000000
+    let dump :: Int -> IO ()
+        dump n = do
+            ts <- listThreads
+            hPutStrLn stderr ("C6-WATCHDOG dump " <> show n <> " threads=" <> show (length ts))
+            mapM_
+                ( \t -> do
+                    st <- threadStatus t
+                    lbl <- threadLabel t
+                    hPutStrLn stderr ("C6-WATCHDOG " <> show t <> " " <> show st <> " " <> show lbl)
+                )
+                ts
+            hFlush stderr
+            threadDelay 5000000
+            dump (n + 1)
+    dump 0
+
 main :: IO ()
 main = do
+    wd <- lookupEnv "C6_WATCHDOG"
+    case wd of
+        Just _ -> void (forkIO c6Watchdog)
+        Nothing -> pure ()
