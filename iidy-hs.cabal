cabal-version: 2.4
name:          iidy-hs
version:       0.1.0.0
synopsis:      CloudFormation preprocessor and deployer
build-type:    Simple

common warnings
  ghc-options: -Wall -Wcompat

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
  exposed-modules:
    Iidy.Types
    Iidy.Yaml.Ast
    Iidy.Yaml.Detection
    Iidy.Yaml.Location
    Iidy.Yaml.Parser
    Iidy.Yaml.PathTracker
    Iidy.Yaml.Errors.Ids
    Iidy.Yaml.Errors.Enhanced
    Iidy.Yaml.Errors.Display
    Iidy.Yaml.Resolution.Context
    Iidy.Yaml.Resolution.Resolver
    Iidy.Yaml.Handlebars.Engine
    Iidy.Yaml.Handlebars.Helpers
    Iidy.Yaml.JMESPath
    Iidy.Yaml.OValue
    Iidy.Yaml.Emitter
    Iidy.Yaml.Engine
    Iidy.Yaml.CustomResources.Params
    Iidy.Yaml.CustomResources.Expansion
    Iidy.Yaml.CustomResources.RefRewriting
    Iidy.Yaml.Imports.Types
    Iidy.Yaml.Imports.Manifest
    Iidy.Yaml.Imports.Loaders.File
    Iidy.Yaml.Imports.Loaders.Env
    Iidy.Yaml.Imports.Loaders.Random
    Iidy.Output.Types
    Iidy.Output.Renderer
    Iidy.Output.Color
    Iidy.Output.Theme
    Iidy.Output.Terminal
    Iidy.Output.Status
    Iidy.Output.Spinner
    Iidy.Output.Manager
    Iidy.Output.Renderers.Interactive
    Iidy.Output.Renderers.Json
    Iidy.Cli
    Iidy.Aws.CredentialSource
    Iidy.Aws.ClientReqToken
    Iidy.Cfn.Types
    Iidy.Cfn.Constants
    Iidy.Cfn.Status
  build-depends:
      base >= 4.17 && < 5
    , aeson
    , bytestring
    , containers
    , HsYAML
    , scientific
    , directory
    , filepath
    , random
    , text
    , time
    , vector

executable iidy-hs
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  default-extensions:
    LambdaCase
    OverloadedStrings
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >= 4.17 && < 5
    , bytestring
    , text
    , iidy-hs
