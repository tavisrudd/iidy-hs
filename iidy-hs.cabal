cabal-version: 2.4
name:          iidy-hs
version:       0.1.0.0
synopsis:      CloudFormation preprocessor and deployer
build-type:    Simple

common warnings
  ghc-options: -Wall -Wcompat

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
  exposed-modules:
    Iidy.Types
    Iidy.Yaml.Ast
    Iidy.Yaml.Detection
    Iidy.Yaml.Location
    Iidy.Yaml.Parser
    Iidy.Yaml.PathTracker
    Iidy.Yaml.Errors.Ids
    Iidy.Yaml.Errors.Enhanced
    Iidy.Yaml.Resolution.Context
    Iidy.Yaml.Resolution.Resolver
    Iidy.Output.Types
    Iidy.Cli
    Iidy.Aws.CredentialSource
    Iidy.Aws.ClientReqToken
    Iidy.Cfn.Types
    Iidy.Cfn.Constants
    Iidy.Cfn.Status
  build-depends:
      base >= 4.17 && < 5
    , aeson
    , bytestring
    , containers
    , HsYAML
    , scientific
    , text
    , time
    , vector

executable iidy-hs
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  default-extensions: OverloadedStrings
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >= 4.17 && < 5
    , iidy-hs
