cabal-version: 2.4
name:          iidy-hs
version:       0.1.0.0
synopsis:      CloudFormation preprocessor and deployer
build-type:    Simple

common warnings
  ghc-options: -Wall -Wcompat

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
  exposed-modules:
    Iidy.Types
    Iidy.Yaml.Ast
    Iidy.Yaml.Detection
    Iidy.Yaml.Location
    Iidy.Yaml.Parser
    Iidy.Yaml.PathTracker
    Iidy.Yaml.Errors.Ids
    Iidy.Yaml.Errors.Enhanced
    Iidy.Yaml.Errors.Display
    Iidy.Yaml.Errors.Conversion
    Iidy.Yaml.Resolution.Context
    Iidy.Yaml.Resolution.Resolver
    Iidy.Yaml.Handlebars.Engine
    Iidy.Yaml.Handlebars.Helpers
    Iidy.Yaml.JMESPath
    Iidy.Yaml.OValue
    Iidy.Yaml.Emitter
    Iidy.Yaml.Engine
    Iidy.Yaml.CustomResources.Params
    Iidy.Yaml.CustomResources.JsonSchema
    Iidy.Yaml.CustomResources.Expansion
    Iidy.Yaml.CustomResources.RefRewriting
    Iidy.Yaml.Imports.Types
    Iidy.Yaml.Imports.Manifest
    Iidy.Yaml.Imports.Loaders.File
    Iidy.Yaml.Imports.Loaders.Env
    Iidy.Yaml.Imports.Loaders.Random
    Iidy.Yaml.Imports.Loaders.S3
    Iidy.Yaml.Imports.Loaders.Ssm
    Iidy.Yaml.Imports.Loaders.Cfn
    Iidy.Yaml.Imports.Loaders.Http
    Iidy.Yaml.Imports.Loaders.Git
    Iidy.Output.Types
    Iidy.Output.Renderer
    Iidy.Output.Color
    Iidy.Output.Theme
    Iidy.Output.Terminal
    Iidy.Output.Status
    Iidy.Output.Spinner
    Iidy.Output.Manager
    Iidy.Output.Renderers.Interactive
    Iidy.Output.Renderers.Json
    Iidy.Confirm
    Iidy.Cli
    Iidy.Cli.Parser
    Iidy.Demo
    Iidy.Explain
    Iidy.Render
    Iidy.GetImport
    Iidy.InitStackArgs
    Iidy.Aws.Config
    Iidy.Aws.CredentialSource
    Iidy.Aws.ClientReqToken
    Iidy.Aws.Sts
    Iidy.Aws.Timing
    Iidy.Cfn.Types
    Iidy.Cfn.Constants
    Iidy.Cfn.Status
    Iidy.Cfn.CommandMetadata
    Iidy.Cfn.Context
    Iidy.Cfn.RequestBuilder
    Iidy.Cfn.TemplateHash
    Iidy.Cfn.TemplateLoader
    Iidy.Cfn.StackOperations
    Iidy.Cfn.StackArgsLoader
    Iidy.Cfn.Operations.Changeset
    Iidy.Cfn.Operations.ConvertStack
    Iidy.Cfn.Operations.CreateStack
    Iidy.Cfn.Operations.CreateOrUpdate
    Iidy.Cfn.Operations.DescribeStack
    Iidy.Cfn.Operations.DescribeStackDrift
    Iidy.Cfn.Operations.EstimateCost
    Iidy.Cfn.Operations.GetStackTemplate
    Iidy.Cfn.Operations.LintTemplate
    Iidy.Cfn.Operations.ListStacks
    Iidy.Cfn.Operations.TemplateApproval
    Iidy.Cfn.Operations.UpdateStack
    Iidy.Cfn.Operations.DeleteStack
    Iidy.Cfn.Operations.WatchStack
    Iidy.Params.Client
    Iidy.Params.Review
  build-depends:
      base >= 4.17 && < 5
    , aeson
    , amazonka
    , amazonka-cloudformation
    , amazonka-s3
    , amazonka-ssm
    , amazonka-sts
    , amazonka-sns
    , bytestring
    , conduit
    , containers
    , crypton
    , directory
    , filepath
    , HsYAML
    , lens
    , memory
    , mtl
    , network
    , optparse-applicative
    , random
    , regex-posix
    , resourcet
    , scientific
    , text
    , time
    , transformers
    , http-conduit
    , process
    , unliftio
    , uuid
    , vector
    , yaml
    , aeson-pretty

executable iidy-hs
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  default-extensions:
    LambdaCase
    OverloadedStrings
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >= 4.17 && < 5
    , amazonka
    , bytestring
    , text
    , unix
    , uuid
    , iidy-hs

test-suite iidy-hs-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
    LambdaCase
    OverloadedStrings
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >= 4.17 && < 5
    , iidy-hs
    , tasty >= 1.4
    , tasty-hunit >= 0.10
    , aeson
    , amazonka-cloudformation
    , bytestring
    , containers
    , directory
    , filepath
    , text
    , vector
    , optparse-applicative
    , QuickCheck
    , tasty-quickcheck
    , time
