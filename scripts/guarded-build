#!/usr/bin/env bash
# guarded-build — run a build or test command under the host-wide iidy-hs
# build rules.
#
# Usage: scripts/guarded-build <command...>
#   e.g. scripts/guarded-build cabal build all
#        scripts/guarded-build cabal test all --test-show-details=direct --test-options=--timeout=60s
#        scripts/guarded-build nix build .#default --max-jobs 1 --cores 4
#
# Rules:
# - One iidy-hs build at a time on this host, across the primary checkout and
#   every worker worktree: the wrapper takes an exclusive flock and waits.
# - The command runs under `choom -n 1000`, so the kernel's OOM killer picks
#   it before the user's session.
# - It refuses to start when available memory is below IIDY_MIN_AVAIL_GB
#   (default 6), as measured by scripts/avail-mem-kb: MemAvailable plus the
#   reclaimable part of the ZFS ARC. Swap on this host is zram, so swap
#   does not count.
# - Nested calls (the pre-commit hook run from a guarded command) reuse the
#   held lock instead of deadlocking on it.
#
# Environment overrides: IIDY_BUILD_LOCK, IIDY_MIN_AVAIL_GB,
# IIDY_LOCK_WAIT_S (default 3600).

set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: scripts/guarded-build <command...>" >&2
  exit 2
fi

if [[ -n "${IIDY_BUILD_LOCK_HELD:-}" ]]; then
  exec "$@"
fi

lock="${IIDY_BUILD_LOCK:-$HOME/src/iidy-hs/.supervisor/build.lock}"
min_gb="${IIDY_MIN_AVAIL_GB:-6}"
wait_s="${IIDY_LOCK_WAIT_S:-3600}"

mkdir -p "$(dirname "$lock")"
exec 9>"$lock"
if ! flock -n 9; then
  echo "guarded-build: waiting for the build lock ($lock)" >&2
  flock -w "$wait_s" 9 || { echo "guarded-build: build lock wait timed out" >&2; exit 75; }
fi

avail_kb=$("$(dirname "$0")/avail-mem-kb")
if [[ "$avail_kb" -lt $((min_gb * 1024 * 1024)) ]]; then
  echo "guarded-build: only $((avail_kb / 1024 / 1024)) GiB available (< ${min_gb}); refusing to build" >&2
  exit 75
fi

export IIDY_BUILD_LOCK_HELD=1
exec choom -n 1000 -- "$@"
