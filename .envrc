use flake
watch_file iidy-hs.cabal

# Keep ./iidy-hs pointing at the binary cabal builds for this shell's GHC.
# The path changes only with the GHC version (flake) or the package version
# (iidy-hs.cabal), and direnv reloads on both.
if iidy_hs_bin=$(cabal list-bin iidy-hs 2>/dev/null); then
  ln -sfn "${iidy_hs_bin#"$PWD"/}" iidy-hs
fi
unset iidy_hs_bin
