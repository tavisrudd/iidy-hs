#!/usr/bin/env bash
# Pre-commit hook: format check, lint, nix deps, build with -Werror, tests
# Skip tests with: SKIP_TESTS=1 git commit
set -euo pipefail

echo "pre-commit: fourmolu check..."
fourmolu --mode check src/ app/ test/

echo "pre-commit: hlint..."
hlint src/ app/ test/

# Check cabal deps are in flake.nix
bash scripts/check-nix-deps.sh

# Builds take the host-wide build lock (scripts/guarded-build) so supervised
# workers committing in parallel never run two GHC builds at once. The
# per-test timeout turns a hung test (card C6) into a named failure.
if [ "${SKIP_TESTS:-0}" != "1" ]; then
  echo "pre-commit: build-strict + test..."
  scripts/guarded-build cabal test all --ghc-options="-Wall -Wcompat -Werror" \
    --test-show-details=direct --test-options=--timeout=60s 2>&1 | tail -5
else
  echo "pre-commit: build-strict (tests skipped)..."
  scripts/guarded-build cabal build all --enable-tests --ghc-options="-Wall -Wcompat -Werror" 2>&1 | tail -5
fi

echo "pre-commit: ok"
